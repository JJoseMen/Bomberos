# SIPPCI Backend - Variables de entorno (ejemplo)
# Copiar como .env y llenar los valores reales

# Servidor
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
API_PREFIX=api
SWAGGER_PATH=api/docs

# Base de datos PostgreSQL local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sippci?schema=public

# JWT
JWT_SECRET=cambiar_por_clave_super_segura_minimo_16_chars
JWT_EXPIRES_IN=7d

# Email (Nodemailer) - OTP REAL: descomentar y completar con app password de Gmail
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=tu_email@gmail.com
#SMTP_PASS=tu_app_password
#SMTP_FROM="SIPPCI" <tu_email@gmail.com>

# Kerberos SSO (true = mock local, false = SSO real)
KERBEROS_MOCK_MODE=false
KERBEROS_URL=https://kerberos.policia.gob.bo/api
KERBEROS_API_KEY=tu_api_key
KERBEROS_TIMEOUT=5000

# Prisma Studio (opcional)
PRISMA_STUDIO_PORT=5555